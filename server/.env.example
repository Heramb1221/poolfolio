# Server Environment Configuration
PORT=4000
NODE_ENV=development

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/poolfolio?schema=public"

# Authentication & Security
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origins (comma-separated)
CLIENT_ORIGIN="http://localhost:8081,http://localhost:19006"
