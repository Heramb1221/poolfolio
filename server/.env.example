# Server Environment Configuration
PORT=4000
NODE_ENV=development

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/poolfolio?schema=public"

# Authentication & Security
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origins (comma-separated)
CLIENT_ORIGIN="http://localhost:8081,http://localhost:19006"

# AI Pipeline (Gemma Integration)
# Option 1: Local Ollama / vLLM / OpenAI-compatible endpoint
GEMMA_API_URL="http://localhost:11434"
GEMMA_MODEL_NAME="gemma2:2b"

# Option 2: Hugging Face Serverless Inference API (Optional)
HUGGINGFACE_API_KEY=""
GEMMA_HF_MODEL="google/gemma-2-2b-it"

# AI Pipeline (TabPFN Anomaly Detection)
# Optional microservice endpoint for TabPFN tabular prediction
TABPFN_API_URL="http://localhost:8000"

# Observability & Monitoring (Sentry)
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.2"


