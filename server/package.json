{
  "name": "poolfolio-server",
  "version": "0.1.0",
  "description": "Backend API server and accounting engine for Poolfolio",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --import tsx --test src/__tests__/auth.test.ts src/__tests__/group.test.ts src/__tests__/investment.test.ts src/__tests__/contribution.test.ts src/__tests__/accounting.unit.test.ts src/__tests__/transaction.test.ts src/__tests__/ai.gemma.test.ts src/__tests__/ai.tabpfn.test.ts",
    "test:unit": "node --import tsx --test src/__tests__/accounting.unit.test.ts src/__tests__/ai.gemma.test.ts src/__tests__/ai.tabpfn.test.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "poolfolio",
    "investment",
    "ledger",
    "accounting",
    "express",
    "prisma"
  ],
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "argon2": "^0.41.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.17.19",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.4.1",
    "supertest": "^7.3.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "private": true
}
