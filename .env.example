# Poolfolio Environment Configuration Example
# Copy this file to .env and adjust variables for your local setup.

# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/poolfolio?schema=public"

# Authentication & Security
# Minimum 32-character high-entropy secret string for JWT signing
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Client CORS Configuration
CLIENT_ORIGIN="http://localhost:8081,http://localhost:19006"

# Observability (Optional for MVP development)
SENTRY_DSN=""
